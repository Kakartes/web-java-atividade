<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
   <img id="gnomo" src="https://th.bing.com/th/id/OIP.WBF3Cn7YLvoCwD_MhOxcJQHaEK?w=303&h=180&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3">
<p id="mensagem"></p>
 <button id="trocarPersonagem">Trocar Personagem</button>
<script>
  const gnomo = document.getElementById("gnomo");
  const mensagem = document.getElementById("mensagem");

  gnomo.addEventListener("mouseenter", () => {
    mensagem.textContent = "¡Hola! Soy un gnomo mágico. ¡Haz clic en mí para descubrir un secreto!";
  });

  gnomo.addEventListener("click", () => {
    mensagem.textContent = "¡Felicidades! Has descubierto el secreto del gnomo mágico. ¡Eres increíble!";
  });

  gnomo.addEventListener("mouseleave", () => {
    mensagem.textContent = "arriba, muchacho";
  });

  gnomo.addEventListener("mousemove", () => {
    mensagem.textContent = ";) movete, muchacho";
  });

  const personagens = [
    "https://th.bing.com/th/id/OIP.WBF3Cn7YLvoCwD_MhOxcJQHaEK?w=303&h=180&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3",
    "https://tse1.mm.bing.net/th/id/OIP.LhzLV0UtG9-lM8A-cig8BgHaFV?r=0&rs=1&pid=ImgDetMain&o=7&rm=3",
    "https://tse1.mm.bing.net/th/id/OIP.FWx-N-z5WxbgJvHmxbORdAHaKA?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" //clique mais de uma vez para ver se muda
  ];
  document.getElementById("trocarPersonagem").addEventListener("click", () => {
    const randomIndex = Math.floor(Math.random() * personagens.length);  //o mesmo que o outro, mas aqui é para pegar um personagem aleatório do array de personagens
    gnomo.src = personagens[randomIndex];
  });


</script>

</body>
</html>
